# --- Obrigatórias ---
DATABASE_URL="postgresql://gym:gym_dev_password@localhost:5432/gym?schema=public"
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# --- Opcionais (valores padrão entre parênteses) ---
PORT=3000
NODE_ENV=development
JWT_EXPIRES_IN=30m              # (30m)
CORS_ORIGINS=http://localhost:5173   # lista separada por vírgula; vazio = CORS desabilitado
CACHE_TTL_SECONDS=60            # (60)
TRUST_PROXY=0                   # nº de proxies confiáveis à frente da API (nginx/Fly = 1)
EXPOSE_INSTANCE_ID=false        # true => header X-Instance-Id (demonstração de load balancing)
SWAGGER_ENABLED=true            # (true)
RUN_MIGRATIONS=false            # true => container roda 'prisma migrate deploy' ao iniciar

# --- Seed (somente desenvolvimento) ---
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=Admin@12345678
